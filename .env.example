# MEDrecord Gateway Configuration
# Copy this file to .env.local and fill in your values

# Gateway URL (the MEDrecord API Gateway)
MEDRECORD_GATEWAY_URL=https://auth-test-b2c.healthtalk.ai

# Your Tenant ID (get from MEDrecord admin)
MEDRECORD_TENANT_ID=your-tenant-id-here

# OAuth Client ID (get from MEDrecord admin)
MEDRECORD_CLIENT_ID=your-client-id-here

# Your application URL (for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: API Key for server-to-server communication
# Only use in development - never commit this value
# MEDRECORD_API_KEY=cak_your_api_key_here
