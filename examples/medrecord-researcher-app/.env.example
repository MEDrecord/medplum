# HealthTalk Gateway Configuration
# Copy this file to .env.local and fill in your values

# Gateway base URL (required)
HEALTHTALK_GATEWAY_URL=https://auth-test-b2c.healthtalk.ai

# Your tenant ID (required) - get this from HealthTalk admin
HEALTHTALK_TENANT_ID=

# Your client ID (required) - get this from HealthTalk admin  
HEALTHTALK_CLIENT_ID=

# API Key for server-to-server communication (optional)
# Only needed for background jobs and webhooks
HEALTHTALK_API_KEY=
