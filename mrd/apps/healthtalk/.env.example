# HealthTalk Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# Gateway Authentication Configuration
# ===========================================

# Gateway URL (MEDrecord Auth Gateway)
# Production: https://auth.healthtalk.ai
# Staging: https://auth-test-b2c.healthtalk.ai
NEXT_PUBLIC_GATEWAY_URL=https://auth-test-b2c.healthtalk.ai

# Tenant ID (your organization's tenant identifier)
# Default: "default" for local development
NEXT_PUBLIC_TENANT_ID=default

# App URL (used for OAuth callbacks)
# - Local development: http://localhost:3000
# - v0 Preview: auto-detected (webToken mode)
# - Production: https://medplum.healthtalk.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Authentication Mode
# ===========================================
# Auth Mode (optional, defaults to 'auto')
# - 'auto': Auto-detect based on domain (RECOMMENDED)
#   - Same domain as gateway (*.healthtalk.ai) -> cookie mode
#   - Different domain (*.vercel.app, *.v0.dev) -> webToken mode
# - 'cookie': Force cookie-based auth (same-domain only, uses auth.sid HttpOnly cookie)
# - 'webtoken': Force webToken-based auth (cross-domain, uses X-Session-Id header)
NEXT_PUBLIC_AUTH_MODE=auto

# ===========================================
# Application Metadata
# ===========================================

# App name (displayed in UI)
NEXT_PUBLIC_APP_NAME="Medplum HealthTalk"

# ===========================================
# How Authentication Works
# ===========================================
#
# COOKIE MODE (Same Domain - Production):
# 1. User clicks login -> redirect to gateway /api/auth/signin
# 2. Gateway handles Azure B2C OAuth flow
# 3. Gateway creates session, sets HttpOnly auth.sid cookie
# 4. Cookie works across *.healthtalk.ai subdomains
# 5. All requests include cookie automatically
#
# WEBTOKEN MODE (Cross Domain - v0 Preview, Vercel):
# 1. User clicks login -> redirect to gateway /api/auth/signin
# 2. Gateway handles Azure B2C OAuth flow
# 3. Gateway redirects back with ?webToken=wst_xxx (60s TTL, single-use)
# 4. App exchanges webToken for sessionId via POST /api/auth/web-session/exchange
# 5. sessionId stored in localStorage, sent as X-Session-Id header
# 6. Session valid for 24 hours, auto-refreshed
#
