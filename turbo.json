{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "MEDPLUM_BASE_URL",
    "MEDPLUM_DIRECT_BASE_URL",
    "MEDPLUM_CLIENT_ID",
    "MEDPLUM_REGISTER_ENABLED",
    "MEDPLUM_AWS_TEXTRACT_ENABLED",
    "MEDPLUM_GATEWAY_URL",
    "MEDPLUM_GATEWAY_TENANT_ID",
    "MEDPLUM_GATEWAY_ENABLED",
    "MEDPLUM_GATEWAY_SERVICE_NAME",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_AUTH_ORIGINS",
    "RECAPTCHA_SITE_KEY",
    "VERCEL_ENV"
  ]
}
