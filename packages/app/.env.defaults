# Local-development defaults for the PRODUCTION environment.
#
# This branch (main) deploys to production, so every host here is a production host.
# The test hosts live on the `test` branch's copy of this file.
#
# MEDPLUM_GATEWAY_SERVICE_NAME must be set explicitly: the gateway registers this backend
# under the slug `fhir-api-prd`, while its host is fhir-api.healthtalk.ai. Deriving the slug
# from the hostname yields `fhir-api`, which no gateway has, and every FHIR call would 404.
#
# Vite loads this only when there is no .env and no MEDPLUM_BASE_URL in the process
# environment (see vite.config.ts), so on Vercel the dashboard variables win.
MEDPLUM_BASE_URL=https://fhir-api.healthtalk.ai/
MEDPLUM_CLIENT_ID=
MEDPLUM_REGISTER_ENABLED=false
MEDPLUM_GATEWAY_ENABLED=true
MEDPLUM_GATEWAY_URL=https://authb2c.healthtalk.ai
MEDPLUM_GATEWAY_SERVICE_NAME=fhir-api-prd
MEDPLUM_APP_NAME=HealthTalk
