{
  "name": "root",
  "version": "5.1.6",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "mrd/packages/*",
    "mrd/apps/*"
  ],
  "scripts": {
    "build": "cd packages/app && npm run build",
    "build:docs": "npx turbo run build --filter=@medplum/docs",
    "dev": "cd packages/app && node ../../node_modules/vite/bin/vite.js --host",
    "start": "cd packages/app && npm run preview",
    "lint": "cd packages/app && npm run lint"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "overrides": {
    "@jest/types": "30.3.0",
    "esbuild": "0.27.4",
    "jest-diff": "30.3.0",
    "jest-message-util": "30.3.0",
    "jest-util": "30.3.0",
    "jest-worker": "30.3.0",
    "jsdom": "29.0.1",
    "typescript": "6.0.2",
    "vite": "8.0.3",
    "whatwg-url": "14.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@fast-check/jest": "2.2.0",
    "@jest/globals": "30.3.0",
    "@jest/types": "30.3.0",
    "@microsoft/api-documenter": "7.29.7",
    "@microsoft/api-extractor": "7.57.7",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.15",
    "babel-jest": "30.3.0",
    "babel-preset-vite": "1.1.3",
    "cross-env": "10.1.0",
    "esbuild": "0.27.4",
    "formidable": "3.5.4",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.3.0",
    "jest-diff": "30.3.0",
    "jest-each": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "jest-message-util": "30.3.0",
    "jest-util": "30.3.0",
    "jest-worker": "30.3.0",
    "jsdom": "29.0.1",
    "npm-check-updates": "19.6.6",
    "nyc": "18.0.0",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "rimraf": "6.1.3",
    "shx": "0.4.0",
    "sort-package-json": "3.6.1",
    "source-map-explorer": "2.5.3",
    "tslib": "2.8.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vite": "8.0.3"
  },
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "dependencies": {
    "@medplum/fhirtypes": "^5.1.6",
    "react": "^19.2.4",
    "swr": "^2.4.1"
  }
}
